# Public LAN hostname. Client devices must trust Caddy's local CA.
VOICE_HOST=voice.local
# Listen on all interfaces for LAN use. Set to 127.0.0.1 for local-only use.
BIND_ADDRESS=0.0.0.0

# LiveKit credentials (generate long random values; never expose the secret).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_URL=ws://livekit:7880
PUBLIC_LIVEKIT_URL=wss://voice.local/livekit
# LAN IP of the Linux VM, reachable by browser clients.
LIVEKIT_NODE_IP=192.168.1.50

# OpenAI-compatible Chat Completions endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-an-available-streaming-model

# Internal inference endpoints.
STT_BASE_URL=http://faster-whisper:8000/v1
STT_MODEL=Systran/faster-whisper-small
# Use auto for Malaysian code-switching, or lock to en, zh, or ms.
STT_LANGUAGE=auto
STT_PROMPT=The speaker may code-switch between Malaysian English Mandarin Chinese and Malay. Preserve each spoken language and transcribe Mandarin as Simplified Chinese. Ignore coughs breathing and other non-speech sounds.
TTS_BASE_URL=http://kokoro:8880/v1
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_CHINESE_VOICE=zf_xiaoxiao
TTS_MALAY_VOICE=af_heart

# v1-mini runs locally. Set to vad only for the lowest-resource fallback.
TURN_DETECTOR_MODE=v1-mini
TURN_DETECTOR_VERSION=v1-mini
# Require recognized speech before stopping assistant playback.
INTERRUPTION_MIN_DURATION=0.8
INTERRUPTION_MIN_WORDS=1
FALSE_INTERRUPTION_TIMEOUT=1.5
RESUME_FALSE_INTERRUPTION=true

SYSTEM_PROMPT=You are a concise friendly voice assistant. Reply in the user's requested language. Otherwise naturally follow the user's mix of Malaysian English Mandarin Chinese and Malay with English as fallback. Keep most replies to one or two short sentences. Avoid markdown because your response will be spoken aloud.
LOG_LEVEL=INFO
TZ=Asia/Kuala_Lumpur
